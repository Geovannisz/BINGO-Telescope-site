{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://v0.app https://*.v0.app https://chatgpt.com https://claude.ai;"
        }
      ]
    }
  ]
}
