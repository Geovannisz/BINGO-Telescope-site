---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  lang?: 'pt' | 'en' | 'zh';
  /** Enable hardcoded native translations (disables Google Translate) */
  nativeI18n?: boolean;
  /** Page identifier for native translation lookup (e.g. 'index', 'about') */
  pageId?: string;
  image?: string;
  article?: boolean;
  publishDate?: Date | string;
  author?: string;
}

const { 
  title, 
  description, 
  lang = 'pt', 
  nativeI18n = false, 
  pageId = '',
  image,
  article,
  publishDate,
  author
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth" style="background-color:#070d1f;color:#e2e8f0;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark only" />
    <link rel="icon" type="image/png" href={`${base}BINGO-Logo-ico.png`} />
    <link rel="apple-touch-icon" href={`${base}BINGO-Logo-ico.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    
    <SEO 
      title={title} 
      description={description} 
      lang={lang}
      image={image}
      article={article}
      publishDate={publishDate}
      author={author}
    />

    <meta name="keywords" content="BINGO, telescópio BINGO, radiotelescópio, BAO, oscilações acústicas de bárions, baryon acoustic oscillations, mapeamento de intensidade, intensity mapping, energia escura, dark energy, hidrogênio neutro, hydrogen 21cm, cosmologia, cosmology, Paraíba, Brasil, Brazil, FRB, fast radio bursts, ABDUS, Uirapuru, rádio astronomia, radio astronomy, Aguiar" />
    {nativeI18n && pageId && <meta name="bingo-native-i18n" content={pageId} />}

    <!-- Smart FOUC Prevention is removed because ClientRouter handles SPA transitions and inline styles handle initial paint -->
    <style is:inline>
      /* Prevents black-text FOUC on slow connections or Tailwind failures */
      html, body { background-color: #070d1f !important; color: #e2e8f0 !important; }
      /* Prevent Google Translate <font> tags from forcing black text */
      font, font[color] { color: inherit !important; }
    </style>
    <!-- Fonts: Inter (body) + Outfit (headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=block">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=block" rel="stylesheet">
    <!-- NOTE: Netlify Identity Widget is loaded only in /admin/index.html, not globally.
         This avoids CORS errors on public pages while keeping the CMS functional. -->
    
    <!-- Native Translation Support -->
  </head>
  <body class="bg-cosmic text-slate-200 font-sans min-h-screen flex flex-col antialiased selection:bg-cyan-500/30" style="background-color:#070d1f;color:#e2e8f0;">
    <!-- Skip-to-content link for keyboard/screen reader users -->
    <a href="#main-content" class="skip-link">Pular para conteúdo principal</a>

    <!-- Noise Overlay (Film Grain) -->
    <div class="fixed inset-0 z-[9999] opacity-[0.035] pointer-events-none mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>

    <Header lang={lang} />
    <main id="main-content" class="flex-grow pt-20"> <!-- pt-20 to account for fixed header -->
      <slot />
    </main>
    <Footer />

    <!-- UI Effects: translations, scroll animations, language switcher, 3D tilt -->
    <script>
      import { initUIEffects } from '../utils/ui-effects';
      document.addEventListener('DOMContentLoaded', () => initUIEffects());
    </script>
  </body>
</html>
