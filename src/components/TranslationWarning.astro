---


interface Props {
  missingLang: string | null;
  lang: 'pt' | 'en' | 'zh-CN' | 'zh';
}

const { missingLang, lang } = Astro.props;
---

{missingLang && (
  <div class="mb-6 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-start gap-3">
    <svg class="w-5 h-5 text-amber-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div>
      <p class="text-amber-400 font-medium text-sm">
        {lang === 'en' 
          ? `This content has not yet been translated to ${missingLang}. Displaying the original Portuguese version.`
          : lang === 'zh' || lang === 'zh-CN'
            ? `此内容尚未翻译成 ${missingLang}。显示原始葡萄牙语版本。`
            : `Este conteúdo ainda não foi traduzido para ${missingLang}. Exibindo a versão original em português.`}
      </p>
    </div>
  </div>
)}
