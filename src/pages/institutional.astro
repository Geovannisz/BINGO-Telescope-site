---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Institucional" description="Comitê de Gestão, documentos da colaboração e recursos institucionais do Consórcio BINGO." nativeI18n pageId="institutional">
  <!-- Page Header -->
  <div class="relative py-24 overflow-hidden section-bg-image" style="min-height: 40vh;">
    <div class="bg-img" style={`background-image: url('${base}images/backgrounds/WMAP_2012-background.png'); opacity: 0.15;`}></div>
    <div class="bg-overlay" style="background: linear-gradient(180deg, rgba(7,13,31,0.5) 0%, rgba(15,23,42,0.85) 70%, #0f172a 100%);"></div>
    <div class="starfield"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl animate-fade-in-up">
        <div class="flex mb-5">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 shadow-[0_0_15px_rgba(6,182,212,0.1)]">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <span data-t="header.label">Governança</span>
          </span>
        </div>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl" style="font-family: 'Outfit', sans-serif;" data-t="header.title">
          <span class="gradient-text-cyan">Institucional</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300" data-t="header.desc">
          Comitê de Gestão, documentos da colaboração e recursos institucionais do Consórcio Telescópio BINGO.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-cosmic pt-10 pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <!-- Management Committee -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span data-t="committee.label">Gestão</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="committee.title">Comitê de Gestão</h2>
        <div class="section-divider mb-4"></div>
        <p class="text-slate-400 max-w-2xl mb-8" data-t="committee.desc">
          O Comitê de Gestão supervisiona a direção estratégica e a coordenação científica da colaboração internacional BINGO.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Elcio Abdalla -->
          <a href={`${base}team/elcio-abdalla/`} class="glass-card-glow p-6 flex flex-col items-center text-center group hover:border-cyan-500/30 transition-all duration-300">
            <div class="w-28 h-28 rounded-full overflow-hidden mb-4 border-2 border-slate-600 group-hover:border-cyan-500/50 group-hover:shadow-md group-hover:shadow-cyan-500/20 transition-all duration-300 flex-shrink-0 bg-slate-700">
              <img src={`${base}images/team/elcio-abdalla.jpg`} alt="Prof. Dr. Elcio Abdalla" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="text-white font-bold text-lg leading-snug group-hover:text-cyan-300 transition-colors" style="font-family: 'Outfit', sans-serif;">Prof. Dr. Elcio Abdalla</p>
            <p class="text-cyan-400 text-sm font-medium mt-1 mb-1" data-t="committee.role.pi">Principal Investigator</p>
            <p class="text-slate-400 text-xs uppercase tracking-wider leading-tight mb-4">Instituto de Física — USP</p>
            <span class="mt-auto inline-flex items-center gap-1 text-xs text-cyan-400/60 group-hover:text-cyan-400 transition-colors" data-t="committee.profile_link">Ver perfil completo →</span>
          </a>

          <!-- Carlos Alexandre Wuensche -->
          <a href={`${base}team/carlos-alexandre-wuensche-de-souza/`} class="glass-card-glow p-6 flex flex-col items-center text-center group hover:border-cyan-500/30 transition-all duration-300">
            <div class="w-28 h-28 rounded-full overflow-hidden mb-4 border-2 border-slate-600 group-hover:border-cyan-500/50 group-hover:shadow-md group-hover:shadow-cyan-500/20 transition-all duration-300 flex-shrink-0 bg-slate-700">
              <img src={`${base}images/uploads/whatsapp-image-2026-10-09-at-18-17-15.webp`} alt="Prof. Dr. Carlos Alexandre Wuensche" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="text-white font-bold text-lg leading-snug group-hover:text-cyan-300 transition-colors" style="font-family: 'Outfit', sans-serif;">Prof. Dr. Carlos Alexandre Wuensche</p>
            <p class="text-cyan-400 text-sm font-medium mt-1 mb-1" data-t="committee.role.copi_instr">Co-PI (Instrumentação)</p>
            <p class="text-slate-400 text-xs uppercase tracking-wider leading-tight mb-4">INPE — São José dos Campos</p>
            <span class="mt-auto inline-flex items-center gap-1 text-xs text-cyan-400/60 group-hover:text-cyan-400 transition-colors" data-t="committee.profile_link">Ver perfil completo →</span>
          </a>

          <!-- Luciano Barosi -->
          <a href={`${base}team/luciano-barosi/`} class="glass-card-glow p-6 flex flex-col items-center text-center group hover:border-cyan-500/30 transition-all duration-300">
            <div class="w-28 h-28 rounded-full overflow-hidden mb-4 border-2 border-slate-600 group-hover:border-cyan-500/50 group-hover:shadow-md group-hover:shadow-cyan-500/20 transition-all duration-300 flex-shrink-0 bg-slate-700">
              <img src={`${base}images/uploads/whatsapp-image-2026-07-06-at-23.43.37.jpeg`} alt="Prof. Dr. Luciano Barosi" class="w-full h-full object-cover" loading="lazy" />
            </div>
            <p class="text-white font-bold text-lg leading-snug group-hover:text-cyan-300 transition-colors" style="font-family: 'Outfit', sans-serif;">Prof. Dr. Luciano Barosi</p>
            <p class="text-cyan-400 text-sm font-medium mt-1 mb-1" data-t="committee.role.copi_site">Co-PI (Site &amp; Operações)</p>
            <p class="text-slate-400 text-xs uppercase tracking-wider leading-tight mb-4">UFCG — Campina Grande</p>
            <span class="mt-auto inline-flex items-center gap-1 text-xs text-cyan-400/60 group-hover:text-cyan-400 transition-colors" data-t="committee.profile_link">Ver perfil completo →</span>
          </a>
        </div>
      </div>

      <!-- Collaboration Documents -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span data-t="docs.label">Documentos</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="docs.title">Documentos da Colaboração</h2>
        <div class="section-divider mb-4"></div>
        <p class="text-slate-400 max-w-2xl mb-8" data-t="docs.desc">
          Documentos oficiais que regem a colaboração BINGO e suas parcerias com agências de fomento.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Management Guidelines -->
          <div class="glass-card-glow p-6">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div>
                <h3 class="text-white font-semibold" style="font-family: 'Outfit', sans-serif;" data-t="docs.guidelines.title">Management Guidelines da Colaboração BINGO</h3>
                <p class="text-slate-400 text-sm mt-1" data-t="docs.guidelines.desc">
                  Diretrizes oficiais que regem a estrutura, responsabilidades e políticas científicas do consórcio BINGO.
                </p>
              </div>
            </div>
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-500 text-sm cursor-not-allowed opacity-60">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span data-t="docs.soon">Disponível em breve</span>
            </button>
          </div>

          <!-- Pioneer Projects -->
          <div class="glass-card-glow p-6">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2v16z"/></svg>
              </div>
              <div>
                <h3 class="text-white font-semibold" style="font-family: 'Outfit', sans-serif;" data-t="docs.pioneer.title">Projetos Pioneiros junto às Agências de Fomento</h3>
                <p class="text-slate-400 text-sm mt-1" data-t="docs.pioneer.desc">
                  Documentação das propostas pioneiras submetidas às agências de fomento que apoiaram a fundação da colaboração BINGO.
                </p>
              </div>
            </div>
            <button disabled class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800/50 border border-slate-700/50 text-slate-500 text-sm cursor-not-allowed opacity-60">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span data-t="docs.soon">Disponível em breve</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Back link -->
      <div class="animate-on-scroll">
        <a href={`${base}about`} class="inline-flex items-center gap-2 text-slate-400 hover:text-cyan-400 transition-colors font-medium">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span data-t="back.link">← Voltar para Sobre o Projeto</span>
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
