---
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news', ({ data }) => data.published !== false);
  return newsEntries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;

const imageUrl = entry.data.image?.startsWith('/') 
  ? `${base}${entry.data.image.slice(1)}` 
  : entry.data.image;

// Pre-compile markdown for translations
const transEn = entry.data.en || {};
const transZh = entry.data.zh || {};
const translations = {
  en: {
    title: transEn.title,
    summary: transEn.summary,
    body: transEn.body ? marked.parse(transEn.body) : null
  },
  zh: {
    title: transZh.title,
    summary: transZh.summary,
    body: transZh.body ? marked.parse(transZh.body) : null
  }
};
---

<BaseLayout nativeI18n={true} pageId="dynamic" 
  title={entry.data.title}
  description={entry.data.summary}
  image={imageUrl}
  article={true}
  publishDate={entry.data.date}
  author={entry.data.author}
>
  <article class="py-24 sm:py-32 bg-slate-900 min-h-screen" data-dynamic-translate="true">
    <!-- Translation Data -->
    <script is:inline id="entry-translations" type="application/json" set:html={JSON.stringify(translations)}></script>

    <div class="mx-auto max-w-3xl px-6 lg:px-8">

      <div class="mb-10">
        <time class="text-cyan-400 font-medium text-sm mb-2 block">{entry.data.date.toLocaleDateString('pt-BR')}</time>
        <h1 id="news-title" class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight mb-6">{entry.data.title}</h1>
        <div class="flex items-center gap-4 text-slate-400 text-sm">
          <span id="news-byline" class="notranslate" translate="no">Por {entry.data.author}</span>
        </div>
      </div>

      {imageUrl && (
        <div class="mb-12 rounded-2xl overflow-hidden aspect-video border border-slate-700">
          <img src={imageUrl} alt={entry.data.title} class="w-full h-full object-cover" />
        </div>
      )}

      <div id="news-body" class="prose prose-invert prose-cyan max-w-none prose-img:rounded-xl prose-img:shadow-lg prose-img:mx-auto prose-a:text-cyan-400 hover:prose-a:text-cyan-300">
        <Content />
      </div>

      <script is:inline define:vars={{ base }}>
        document.addEventListener('DOMContentLoaded', () => {
          const lang = localStorage.getItem('bingo-lang') || 'en';
          if (lang === 'pt') return;
          
          const nLang = lang === 'zh-CN' ? 'zh' : lang;
          const transEl = document.getElementById('entry-translations');
          if (!transEl || !transEl.textContent) return;
          const translations = JSON.parse(transEl.textContent);
          const data = translations[nLang];
          
          const hasTrans = data && (data.title || data.body);
          if (hasTrans) {
            // Manual translation exists → apply and mark as notranslate
            if (data.title) {
              const titleEl = document.getElementById('news-title');
              titleEl.innerHTML = data.title;
              titleEl.classList.add('notranslate');
              titleEl.setAttribute('translate', 'no');
              document.title = data.title + " | BINGO Telescope";
            }
            if (data.body) {
              const bodyEl = document.getElementById('news-body');
              bodyEl.innerHTML = data.body;
              bodyEl.classList.add('notranslate');
              bodyEl.setAttribute('translate', 'no');
            }
            
            // Fix markdown image paths
            document.querySelectorAll('.prose img').forEach((img) => {
              const src = img.getAttribute('src');
              if (src && src.startsWith('/') && !src.startsWith(base)) {
                img.setAttribute('src', base + src.slice(1));
              }
            });
          }
          // No manual translation → leave as-is, Google Translate handles it

          // Always translate structural UI elements natively
          const byline = document.getElementById('news-byline');
          if (byline) {
            const author = byline.textContent.replace('Por ', '');
            byline.textContent = nLang === 'zh' ? '作者：' + author : 'By ' + author;
          }
          const backLink = document.getElementById('news-back-link');
          if (backLink) {
            backLink.textContent = nLang === 'zh' ? '返回新闻' : 'Back to News';
          }
        });
      </script>

      <div class="mt-16 pt-8 border-t border-slate-800">
        <a href={`${base}news`} class="inline-flex items-center text-cyan-400 hover:text-cyan-300 font-medium transition-colors">
          <svg class="mr-2 w-5 h-5 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <span id="news-back-link" class="notranslate" translate="no">Voltar para Notícias</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
