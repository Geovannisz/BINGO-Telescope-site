---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Imprensa / Press" description="Releases oficiais, contatos institucionais e recursos de comunicação do Telescópio BINGO para jornalistas e profissionais de mídia." nativeI18n pageId="press">
  <!-- Page Header -->
  <div class="relative py-24 overflow-hidden section-bg-image" style="min-height: 40vh;">
    <div class="bg-img" style={`background-image: url('${base}images/backgrounds/WMAP_2012-background.png'); opacity: 0.15;`}></div>
    <div class="bg-overlay" style="background: linear-gradient(180deg, rgba(7,13,31,0.5) 0%, rgba(15,23,42,0.85) 70%, #0f172a 100%);"></div>
    <div class="starfield"></div>
    <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl animate-fade-in-up">
        <div class="flex mb-5">
          <span class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 shadow-[0_0_15px_rgba(6,182,212,0.1)]">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
            <span data-t="header.label">Imprensa</span>
          </span>
        </div>
        <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl" style="font-family: 'Outfit', sans-serif;" data-t="header.title">
          Imprensa e <span class="gradient-text-cyan">Comunicação</span>
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300" data-t="header.desc">
          Releases oficiais, contatos institucionais e recursos de comunicação para jornalistas e profissionais de mídia que cobrem o projeto Telescópio BINGO.
        </p>
      </div>
    </div>
  </div>

  <div class="bg-cosmic pt-10 pb-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">

      <!-- Press Releases -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span data-t="releases.label">Releases Oficiais</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="releases.title">Press Releases</h2>
        <div class="section-divider mb-8"></div>
        <div class="info-card p-8 text-center">
          <svg class="w-12 h-12 text-slate-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <p class="text-slate-400" data-t="releases.empty">Nenhum press release publicado ainda. Volte em breve.</p>
        </div>
      </div>

      <!-- About the Project -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span data-t="about.label">Sobre o Projeto</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="about.title">
          Sobre o <span class="gradient-text-cyan">BINGO</span>
        </h2>
        <div class="section-divider mb-8"></div>
        <div class="glass-card-glow p-8">
          <p class="text-slate-300 leading-relaxed mb-6" data-t="about.desc">
            O BINGO (Baryon Acoustic Oscillations from Integrated Neutral Gas Observations) é um inovador radiotelescópio internacional em construção no Brasil, projetado para realizar a primeira detecção das Oscilações Acústicas de Bárions (BAO) em frequências de rádio e estudar a natureza da Energia Escura. O projeto é liderado pelo Brasil — por meio da USP, do INPE e da UFCG — em colaboração com instituições da China, Reino Unido, França e Holanda. O telescópio está sendo construído na Serra do Urubu, em Aguiar, Paraíba.
          </p>
          <a href={`${base}about`} class="inline-flex items-center text-cyan-400 hover:text-cyan-300 font-medium transition-colors">
            <span data-t="about.readmore">Leia mais sobre o projeto</span>
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Contacts -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span data-t="contacts.label">Contatos</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="contacts.title">Informações de Contato</h2>
        <div class="section-divider mb-8"></div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Social Networks -->
          <div class="glass-card-glow p-6">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2" style="font-family: 'Outfit', sans-serif;">
              <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
              <span data-t="contacts.social.title">Redes Sociais</span>
            </h3>
            <ul class="space-y-3">
              <li>
                <a href="https://www.instagram.com/bingotelescopio/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-300 hover:text-pink-400 transition-colors text-sm">
                  <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  @bingotelescopio
                </a>
              </li>
              <li>
                <a href="https://www.youtube.com/@bingotelescope" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-300 hover:text-red-400 transition-colors text-sm">
                  <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                  @bingotelescope
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/BINGOTelescopio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-300 hover:text-blue-400 transition-colors text-sm">
                  <svg class="h-4 w-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  BINGOTelescopio
                </a>
              </li>
              <li>
                <a href="https://bingotelescope.org" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-slate-300 hover:text-cyan-400 transition-colors text-sm">
                  <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                  bingotelescope.org
                </a>
              </li>
            </ul>
          </div>

          <!-- Physical Addresses -->
          <div class="glass-card-glow p-6">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2" style="font-family: 'Outfit', sans-serif;">
              <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span data-t="contacts.addresses.title">Endereços Físicos</span>
            </h3>
            <ul class="space-y-4 text-sm text-slate-400">
              <li>
                <p class="text-cyan-400 font-semibold mb-1">UFCG</p>
                <p class="leading-relaxed" data-t="contacts.addresses.ufcg">
                  Universidade Federal de Campina Grande — Departamento de Física<br/>
                  R. Aprígio Veloso, 882 — Bodocongó<br/>
                  Campina Grande — PB, 58429-900 — Brasil
                </p>
              </li>
              <li>
                <p class="text-cyan-400 font-semibold mb-1">USP</p>
                <p class="leading-relaxed" data-t="contacts.addresses.usp">
                  Universidade de São Paulo — Instituto de Física<br/>
                  Rua do Matão, 1371 — Cidade Universitária<br/>
                  São Paulo — SP, 05508-090 — Brasil
                </p>
              </li>
              <li>
                <p class="text-cyan-400 font-semibold mb-1">INPE</p>
                <p class="leading-relaxed" data-t="contacts.addresses.inpe">
                  Instituto Nacional de Pesquisas Espaciais<br/>
                  Av. dos Astronautas, 1758 — Jardim da Granja<br/>
                  São José dos Campos — SP, 12227-010 — Brasil
                </p>
              </li>
            </ul>
          </div>

          <!-- Institutional Emails -->
          <div class="glass-card-glow p-6">
            <h3 class="text-lg font-semibold text-white mb-4 flex items-center gap-2" style="font-family: 'Outfit', sans-serif;">
              <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span data-t="contacts.emails.title">E-mails Institucionais</span>
            </h3>
            <ul class="space-y-3 text-sm">
              <li>
                <span class="text-slate-500 text-xs uppercase tracking-wider" data-t="contacts.emails.general">Geral</span>
                <a href="mailto:info@bingotelescope.org" class="block text-slate-300 hover:text-cyan-400 transition-colors mt-0.5">info@bingotelescope.org</a>
              </li>
              <li>
                <span class="text-slate-500 text-xs uppercase tracking-wider">UFCG</span>
                <a href="mailto:radiotelecopiobingo@df.ufcg.edu.br" class="block text-slate-300 hover:text-cyan-400 transition-colors mt-0.5">radiotelecopiobingo@df.ufcg.edu.br</a>
                <a href="mailto:bingotelescope@df.ufcg.edu.br" class="block text-slate-300 hover:text-cyan-400 transition-colors mt-0.5">bingotelescope@df.ufcg.edu.br</a>
              </li>
              <li>
                <span class="text-slate-500 text-xs uppercase tracking-wider">USP</span>
                <a href="mailto:bingotelescope@usp.br" class="block text-slate-300 hover:text-cyan-400 transition-colors mt-0.5">bingotelescope@usp.br</a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Quero Contribuir -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
            <span data-t="contribute.label">Contribuir</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="contribute.title">Quero Contribuir</h2>
        <div class="section-divider mb-8"></div>
        <div class="glass-card-glow p-8">
          <p class="text-slate-300 leading-relaxed mb-6" data-t="contribute.desc">
            Tem interesse em contribuir com o projeto BINGO? Entre em contato pelos nossos canais oficiais ou diretamente com a equipe.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div>
              <h3 class="text-white font-semibold mb-3" style="font-family: 'Outfit', sans-serif;" data-t="contribute.channels.title">Canais Oficiais</h3>
              <ul class="space-y-2 text-sm text-slate-400">
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-pink-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                  <a href="https://www.instagram.com/bingotelescopio/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">Instagram: @bingotelescopio</a>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400/60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
                  <a href="https://bingotelescope.org" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">bingotelescope.org</a>
                </li>
                <li class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-cyan-400/60 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  <a href="mailto:info@bingotelescope.org" class="hover:text-cyan-400 transition-colors">info@bingotelescope.org</a>
                </li>
              </ul>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-3" style="font-family: 'Outfit', sans-serif;" data-t="contribute.team.title">Contato com a Equipe</h3>
              <ul class="space-y-3 text-sm text-slate-400">
                <li>
                  <p class="text-white font-medium">Prof. Dr. Elcio Abdalla</p>
                  <a href="mailto:eabdalla@usp.br" class="hover:text-cyan-400 transition-colors">eabdalla@usp.br</a>
                </li>
                <li>
                  <p class="text-white font-medium">Prof. Dr. Luciano Barosi</p>
                  <a href="mailto:lbarosi@df.ufcg.edu.br" class="hover:text-cyan-400 transition-colors">lbarosi@df.ufcg.edu.br</a>
                </li>
                <li>
                  <p class="text-white font-medium">Prof. Dr. Carlos Alexandre Wuensche</p>
                  <a href="mailto:ca.wuensche@inpe.br" class="hover:text-cyan-400 transition-colors">ca.wuensche@inpe.br</a>
                </li>
                <li>
                  <p class="text-white font-medium">Dr. Jordany Vieira</p>
                  <a href="mailto:jordanyv@gmail.com" class="hover:text-cyan-400 transition-colors">jordanyv@gmail.com</a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Interview Contacts -->
      <div class="mb-20 animate-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider text-cyan-400 bg-cyan-500/10 border border-cyan-500/20">
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
            <span data-t="interviews.label">Mídia</span>
          </span>
        </div>
        <h2 class="text-2xl font-bold text-white mb-4" style="font-family: 'Outfit', sans-serif;" data-t="interviews.title">Contato para Entrevistas</h2>
        <div class="section-divider mb-8"></div>
        <div class="glass-card-glow p-8">
          <p class="text-slate-300 leading-relaxed mb-6" data-t="interviews.desc">
            Para solicitações de entrevistas, use os e-mails institucionais abaixo. Nossa equipe responderá o mais breve possível.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="info-card p-5">
